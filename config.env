# config.env — локальные пути и параметры стенда DIPLOMA (newmain branch)
# Источник истины по параметрам методологии: docs/methodology/METHODOLOGY_FINAL.md
# НЕ коммитить в git (добавлен в .gitignore)
# Шаблон: config.env.example

# -----------------------------------------------------------------------
# Внешние датасеты (вне git-репозитория)
# -----------------------------------------------------------------------
DATASETS_ROOT=/Users/kuprich/Documents/diploma_repo/datasets
HAI_DATASET_PATH=${DATASETS_ROOT}/dataset hai /hai
KELMARSH_PATH=${DATASETS_ROOT}/kelmarsh
ROAD_SAFETY_PATH=${DATASETS_ROOT}/Road safety open data
OPENWINDSCADA_PATH=${DATASETS_ROOT}/OpenWindSCADA/OpenWindSCADA
WIOD_NIOT_PATH=./matrix_doc/sources/NIOTS

# -----------------------------------------------------------------------
# Результаты калибровки (внутри репозитория)
# -----------------------------------------------------------------------
CALIBRATION_PATH=./data/calibration
SIGMA_PATH=${CALIBRATION_PATH}/sigma_calibrated.json
CAPACITY_PATH=${CALIBRATION_PATH}/capacity_thresholds.json
MATRIX_A_PATH=${CALIBRATION_PATH}/A_leontief.json
SCENARIOS_PATH=./data/scenarios
RESULTS_PATH=./results

# -----------------------------------------------------------------------
# Параметры СДУ-интегратора (Euler-Maruyama)
# -----------------------------------------------------------------------
SDE_DT=0.01
SDE_T_MAX=100
SDE_T_STEPS=10000

# -----------------------------------------------------------------------
# Monte-Carlo
# -----------------------------------------------------------------------
MC_N_RUNS=10000
MC_SEED_METHOD=SHA256

# -----------------------------------------------------------------------
# Оптимизатор (TODO)
# -----------------------------------------------------------------------
OPTIMIZER_BUDGET=1.0
OPTIMIZER_EPOCHS=100
OPTIMIZER_LR=0.01

# -----------------------------------------------------------------------
# Параметры методологии (METHODOLOGY_FINAL.md)
# -----------------------------------------------------------------------
# Pre-registered per METHODOLOGY_FINAL.md §3.3 eq (9):
# θ_node := max_j x_j^baseline + Δ_margin, Δ_margin ≥ 0.05.
# Для baseline (0.667, 0, 0.333) даёт θ ≥ 0.72; в основной серии зафиксировано 0.70
# (устойчивость подтверждена sensitivity-sweep, плато K_q в [0.40, 0.90]).
THETA_NODE=0.70
# Порог значимой деградации per METHODOLOGY_FINAL.md §4.1 eq (10).
DELTA=0.10
# Число прогонов Монте-Карло per METHODOLOGY_FINAL.md §7 / §9.1.
N_RUNS=5000
# Число ресэмплов парного бутстрэпа per METHODOLOGY_FINAL.md §8.1.
B_BOOTSTRAP=10000
# Spectral-radius bound per METHODOLOGY_FINAL.md §2.2 eq (3).
RHO_TARGET=0.95
# Горизонт моделирования и шаг per METHODOLOGY_FINAL.md §7 (шаг 3).
T=60
DT=1

# -----------------------------------------------------------------------
# Recovery Dynamics (METHODOLOGY_FINAL.md §10.2, формула 23).
# Default disabled: κ = 0 эквивалентно основному оператору формулы (5).
# -----------------------------------------------------------------------
KAPPA_ENERGY=0.0
KAPPA_WATER=0.0
KAPPA_TRANSPORT=0.0
# Окрестность baseline для τ^rec (формула 25).
EPSILON_REC=0.02

# -----------------------------------------------------------------------
# Канонический DebtRank baseline K^(DR) (METHODOLOGY_FINAL.md §10.1).
# Серия 4, сравнительный оператор; реализация — TODO (k_dr.py placeholder).
# -----------------------------------------------------------------------
K_DR_ENABLED=false

# -----------------------------------------------------------------------
# SNR acceptance check (METHODOLOGY_FINAL.md §5.2 формула 18).
# При SNR_j < 1 калибровка σ отвергается (инфляция срабатываний K_q).
# -----------------------------------------------------------------------
SNR_THRESHOLD=1.0

# -----------------------------------------------------------------------
# Docker сервисы
# -----------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=diploma
LOG_LEVEL=INFO
ENV=dev
