# config.env.example — шаблон конфигурации DIPLOMA (newresearch branch)
# Скопируйте в config.env и подставьте реальные пути:
#   cp config.env.example config.env

# -----------------------------------------------------------------------
# Внешние датасеты (вне git-репозитория)
# -----------------------------------------------------------------------
DATASETS_ROOT=/path/to/datasets
HAI_DATASET_PATH=${DATASETS_ROOT}/dataset hai /hai
KELMARSH_PATH=${DATASETS_ROOT}/kelmarsh
ROAD_SAFETY_PATH=${DATASETS_ROOT}/Road safety open data
OPENWINDSCADA_PATH=${DATASETS_ROOT}/OpenWindSCADA/OpenWindSCADA
WIOD_NIOT_PATH=./matrix_doc/sources/NIOTS

# -----------------------------------------------------------------------
# Результаты калибровки (внутри репозитория)
# -----------------------------------------------------------------------
CALIBRATION_PATH=./data/calibration
SIGMA_PATH=${CALIBRATION_PATH}/sigma_calibrated.json
CAPACITY_PATH=${CALIBRATION_PATH}/capacity_thresholds.json
MATRIX_A_PATH=${CALIBRATION_PATH}/A_leontief.json
SCENARIOS_PATH=./data/scenarios
RESULTS_PATH=./results

# -----------------------------------------------------------------------
# Параметры СДУ-интегратора (Euler-Maruyama)
# -----------------------------------------------------------------------
SDE_DT=0.01
SDE_T_MAX=100
SDE_T_STEPS=10000

# -----------------------------------------------------------------------
# Monte-Carlo
# -----------------------------------------------------------------------
MC_N_RUNS=10000
MC_SEED_METHOD=SHA256

# -----------------------------------------------------------------------
# Оптимизатор (TODO)
# -----------------------------------------------------------------------
OPTIMIZER_BUDGET=1.0
OPTIMIZER_EPOCHS=100
OPTIMIZER_LR=0.01

# -----------------------------------------------------------------------
# Docker сервисы
# -----------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=diploma
LOG_LEVEL=INFO
ENV=dev
