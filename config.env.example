# config.env.example — шаблон конфигурации DIPLOMA (newmain branch)
# Источник истины по параметрам методологии: docs/methodology/METHODOLOGY_FINAL.md
# Скопируйте в config.env и подставьте реальные пути:
#   cp config.env.example config.env

# -----------------------------------------------------------------------
# Внешние датасеты (вне git-репозитория)
# -----------------------------------------------------------------------
DATASETS_ROOT=/path/to/datasets
HAI_DATASET_PATH=${DATASETS_ROOT}/dataset hai /hai
KELMARSH_PATH=${DATASETS_ROOT}/kelmarsh
ROAD_SAFETY_PATH=${DATASETS_ROOT}/Road safety open data
OPENWINDSCADA_PATH=${DATASETS_ROOT}/OpenWindSCADA/OpenWindSCADA
WIOD_NIOT_PATH=./matrix_doc/sources/NIOTS

# -----------------------------------------------------------------------
# Результаты калибровки (внутри репозитория)
# -----------------------------------------------------------------------
CALIBRATION_PATH=./data/calibration
SIGMA_PATH=${CALIBRATION_PATH}/sigma_calibrated.json
CAPACITY_PATH=${CALIBRATION_PATH}/capacity_thresholds.json
MATRIX_A_PATH=${CALIBRATION_PATH}/A_leontief.json
SCENARIOS_PATH=./data/scenarios
RESULTS_PATH=./results

# -----------------------------------------------------------------------
# Параметры СДУ-интегратора (Euler-Maruyama)
# -----------------------------------------------------------------------
SDE_DT=0.01
SDE_T_MAX=100
SDE_T_STEPS=10000

# -----------------------------------------------------------------------
# Monte-Carlo
# -----------------------------------------------------------------------
MC_N_RUNS=10000
MC_SEED_METHOD=SHA256

# -----------------------------------------------------------------------
# Оптимизатор (TODO)
# -----------------------------------------------------------------------
OPTIMIZER_BUDGET=1.0
OPTIMIZER_EPOCHS=100
OPTIMIZER_LR=0.01

# -----------------------------------------------------------------------
# Параметры методологии (METHODOLOGY_FINAL.md)
# -----------------------------------------------------------------------
# Pre-registered per METHODOLOGY_FINAL.md §3.3 eq (9); satisfies θ ≥ max(x_baseline) + 0.05
THETA_NODE=0.70
# Significant degradation threshold per METHODOLOGY_FINAL.md §4.1 eq (10)
DELTA=0.10
# Monte Carlo runs per METHODOLOGY_FINAL.md §7
N_RUNS=5000
# Paired bootstrap resamples per METHODOLOGY_FINAL.md §8.1
B_BOOTSTRAP=10000
# Spectral radius bound per METHODOLOGY_FINAL.md §2.2 eq (3)
RHO_TARGET=0.95
# Horizon and step per METHODOLOGY_FINAL.md §7
T=60
DT=1

# -----------------------------------------------------------------------
# Recovery Dynamics (METHODOLOGY_FINAL.md §10.2, default disabled)
# -----------------------------------------------------------------------
KAPPA_ENERGY=0.0
KAPPA_WATER=0.0
KAPPA_TRANSPORT=0.0
EPSILON_REC=0.02

# -----------------------------------------------------------------------
# K_DR canonical DebtRank baseline (METHODOLOGY_FINAL.md §10.1)
# -----------------------------------------------------------------------
K_DR_ENABLED=false

# -----------------------------------------------------------------------
# SNR acceptance check (METHODOLOGY_FINAL.md §5.2 eq (18))
# -----------------------------------------------------------------------
SNR_THRESHOLD=1.0

# -----------------------------------------------------------------------
# Docker сервисы
# -----------------------------------------------------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=diploma
LOG_LEVEL=INFO
ENV=dev
